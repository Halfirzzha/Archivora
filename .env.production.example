# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION - Laravel Filament Archivora
# CRITICAL: Copy to .env and fill all values before deployment
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CORE
# -----------------------------------------------------------------------------
APP_NAME=Archivora
APP_ENV=production
APP_KEY=  # Generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=archivora_production
DB_USERNAME=archivora_user
DB_PASSWORD=  # CHANGE THIS! Use strong password (32+ chars, mix of upper/lower/numbers/special)

# Database port forwarding (REMOVE IN PRODUCTION or bind to 127.0.0.1 only)
FORWARD_DB_PORT=5432

# -----------------------------------------------------------------------------
# CACHE & SESSION (Redis for production performance)
# -----------------------------------------------------------------------------
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# QUEUE (Redis for async job processing)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=  # CHANGE THIS! Use strong password
REDIS_PORT=6379

# Redis port forwarding (REMOVE IN PRODUCTION)
FORWARD_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MAIL CONFIGURATION
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailpit (for staging/development only - use profile: dev)
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# -----------------------------------------------------------------------------
# MINIO / S3 CONFIGURATION (Private File Storage)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=minio
AWS_ACCESS_KEY_ID=  # CHANGE THIS! Min 20 chars
AWS_SECRET_ACCESS_KEY=  # CHANGE THIS! Min 40 chars
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=archivora
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=${AWS_ACCESS_KEY_ID}
MINIO_ROOT_PASSWORD=${AWS_SECRET_ACCESS_KEY}

# MinIO port forwarding
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=8900

# -----------------------------------------------------------------------------
# MEILISEARCH (Full-Text Search Engine)
# -----------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=  # CHANGE THIS! Use strong master key
MEILISEARCH_NO_ANALYTICS=true

FORWARD_MEILISEARCH_PORT=7700

# -----------------------------------------------------------------------------
# DOCKER CONFIGURATION
# -----------------------------------------------------------------------------
# User/Group IDs (match host user for volume permissions)
WWWUSER=1000
WWWGROUP=1000

# Port mappings
APP_PORT=80
APP_PORT_SSL=443
VITE_PORT=5173

# Deployment flags (set to true when deploying)
RUN_MIGRATIONS=true
CACHE_CONFIGS=true

# -----------------------------------------------------------------------------
# VITE (Frontend Build Tool)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# BROADCAST (Real-time events - configure when needed)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# SECURITY HEADERS (add to .env if using custom reverse proxy)
# -----------------------------------------------------------------------------
# TRUSTED_PROXIES=*
# ASSET_URL=https://cdn.yourdomain.com
